{
  "description": "Codex Agentic Workflow hooks. SessionStart surfaces active blockers/handoffs; UserPromptSubmit gives a concise workflow reminder for complex work.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/session-start.mjs\"'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'node \"${CODEX_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/scripts/user-prompt-submit.mjs\"'"
          }
        ]
      }
    ]
  }
}
